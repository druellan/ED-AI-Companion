import os

# Usually you only need to change this information to match your Commander.
USER_INFORMATION = """
# About the user:

## Current goal:
Trade, engineering, mining

## Interests:
A generations ship

"""

# Add effects to the TTS voice
TTS_EFFECTS = True

# If this value is set to true, the AI can suffer damage
# The audio is going to degrade based on the hull damage
DAMAGE_EFFECTS = True


# Enter the API endpoint of the LLM service you want to use, the API Key and the model
LLM_ENDPOINT = "https://openrouter.ai/api/v1/"
LLM_API_KEY = (
    ""
)
# The primary model to use, and a list of models to use if the primary model fails
# LLM_MODEL_NAME = "google/gemini-2.0-flash-exp:free"
# LLM_MODEL_NAME = "mistralai/mistral-small-3.2-24b-instruct:free"
LLM_MODEL_NAME = "mistralai/mistral-small-3.1-24b-instruct:free"
# LLM_MODEL_NAME = "deepseek/deepseek-chat-v3-0324:free"
# LLM_MODEL_NAME = "qwen/qwen3-4b:free"

# To use the fallback from Openrouter
LLM_MODEL_NAMES = []
LLM_MAX_TOKENS_ALERT = 32000


# Use WINDOWS for the built in TTS Windows feature
# Use EDGE for the Edge Browser/Azure TTS service, can introduce some extra latency
TTS_TYPE = "EDGE"

# The voice to use for each of the TTS services
# TTS_WINDOWS_VOICE = "Microsoft Zira Desktop - English (United States)"
# TTS_EDGE_VOICE = "en-GB-LibbyNeural"
TTS_EDGE_VOICE = "en-US-AvaMultilingualNeural"
TTS_EDGE_RATE = "+20%"
TTS_EDGE_VOLUME = "-50%"
TTS_EDGE_PITCH = "+0Hz"

# Microsoft Eva (Cortana's voice) is not available in Windows by default,
# try following this guide to activate it: https://github.com/watermarkhu/enable-microsoft-eva-tts
TTS_WINDOWS_VOICE = "Microsoft Eva Mobile - English (United States)"
TTS_WINDOWS_RATE = 180
TTS_WINDOWS_VOLUME = 0.8

# List all the Windows voices available in the system
TTS_WINDOWS_LIST = False


# The folder for the Elite Dangerous journal, usually you don't need to change this one
JOURNAL_DIRECTORY = os.path.join(
    os.environ["USERPROFILE"], "Saved Games", "Frontier Developments", "Elite Dangerous"
)

# How often the code is going to look for new events to send to the AI, in seconds
JOURNAL_TIME_INTERVAL = 1

# Limits for the memory
JOURNAL_EVENT_MEMORY = 30
JOURNAL_RESPONSE_MEMORY = 30

# Use this if you want to use the full event information while remembering
JOURNAIL_EVENT_MEMORY_FULL = True

# The URL to the EDSM API to fetch information about the target system
EDSM_API = "https://www.edsm.net"

SYSTEM_PROMPT = """# Context and Persona
You are a computer AI inside the user starship in the game Elite Dangerous; you have vast technical knowledge about ship systems and the Elite Dangerous universe
The user will provide current ship status and game events in compact text format
You are funny but formal; address the user as Commander; you and the user are a team
You always prioritize ship safety and risk mitigation

# Response Guidelines
Use brief but natural language; never ask questions
Respond in plain text (no markdown, no lists,no titles/headers, or formatting)
Respond starting with "NULL" if you need to remain silent, ignore or skip all of the events (state the reason)
Ignore pronunciation of symbols in names (underscore, slash, dash, etc)
Round fractions to integers and large numbers to nearest million

# Ship system status parameters table
Fuel Level: Warning < 25%, Critical < 10%; Higher risk in route to a non-scoopable star
Hull Health: Warning < .5, Critical < .2; Risk increases if under attack
Oxygen Level: Warning < 5 min, Critical < 2 min; Emergency priority when critical
Temperature: Warning > 80°C, Critical > 95°C
Shield Status: Warning < 20%, Critical 0% (offline)
System Security: Warning "Low" or "Anarchy"; Higher risk with cargo
Threat Level: Minor/Caution 1-2, High/Major 3-4-5, Dangerous > 5; Higher risk with cargo
System with no planets and no humans = barren
System with planets but no humans = deserted

# Priority response triggers
1 Immediate dangers: ship at danger or parameter at critical levels
2 Potential threats: hostile ships, compromised nav beacons, hostile messages, anarchy systems
3 Human players: player ships, player messages, faction activities, community goals
4 Legal changes: fines, bounties, illegal cargo
5 Monetary gain: missions, deadlines, opportunities

# Event response logic, on each event
Check ship system status parameters first
Evaluate event significance based on "Priority response triggers"
Always interpret, never repeat the event content
Respond only if event is important or changes conditions
Responses must start with a single-line summary, followed by brief explanations only when necessary
Use previous events and responses to avoid repetition; acknowledge previous responses and events when necessary
Feel free to remain silent

# Current ship status:
{current_status}

# Ship cargo:
{current_cargo}

# Current route and destination:
{navroute_status}

# Active missions:
{current_missions}

{user_information}

"""

USER_PROMPT = """
# This is the event or a list of events that just happened:
{event_new}
"""

# Idle time starts counting from the last event received from the game, even if the AI decided not to react to that event
IDLE_TIMEOUT = 380  # seconds
IDLE_PROMPT = """
Nothing is happening right now, so, you can chat.
Check previous events.
Check previous responses.
Comment, give a suggestion or just ignore this event.
Be brief.
"""


# You can turn off the use of tools
# The AI use tools to retrieive more information about the events, and can consume 3 times the amount of tokens
LLM_USE_TOOLS = True
TOOLS_PROMPT = """
# Tool Usage
Use tools when event information is insufficient and additional context enhances response
Extract relevant information only integrate findings naturally ignore empty data
"""

# This is no longer needed, I've found the AI can handle the events by itself
# Remember this about stars:
# Type K (Orange star): scoopable for fuel.
# Type G (Yellow star): scoopabl for fuele.
# Type B (Blue-White start): scoopable for fuel.
# Type F (White star): scoopable for fuel.
# Type O (Blue star): scoopable for fuel.
# Type A (Blue-White star): scoopable for fuel.
# Type M (Red Dwarf): scoopable for fuel.
# You have a professional and formal tone, technical knowledge of the ship systems, you focus on safety, and has neutral political views.
# Type L (Brown dwarf): not scoopable for fuel.
# Type T (Brown dwarf): not scoopable for fuel.
# Type Y (Brown dwarf): not scoopable for fuel.

# # Knowledge graph: memory usage:
# Read and store information in the knowledge graph.

# ## Memory retrieval
# At start of each interaction retrieve all relevant information from knowledge graph search_nodes prioritize recent and semantically related data

# ## Memory creation
# Detect and store new information in these categories
# a pilot identification: store data on remarkable NPCs and human pilots including reputation bounty legal status and rank
# b behaviors: track recurring event patterns, pilot tactics and system or faction state changes affecting risks and opportunities
# c commodities: note rare goods, stolen or illegal cargo sources linked to stations or systems
# d exploration: record significant discoveries planetary bodies resource hotspots anomalies include system coordinates and faction context
# Tag all memory entries by event type timestamp and create relations between pilots factions cargo and systems
# Flag critical incidents such as emergency states or notable hostile encounters for priority awareness

# ## Memory update
# If new data found update memory:
# a link new entities to existing ones through relations
# b avoid duplicates by merging similar data

